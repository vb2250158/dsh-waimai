{
  "name": "dsh-waimai",
  "version": "0.2.0",
  "description": "DSH 多平台外卖助手：淘宝闪购 HTTP 短信登录、账号头像、地址选择与历史订单；美团和京东待接入。购买接口未验证时停止。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION-0.2.0.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node --check lib/index.js && node --check lib/mcp-server.js && node --check lib/mcp-bridge.js && node --check lib/automation.js && node --check lib/payments.js && node --check lib/env.js && node --check lib/paths.js && node --check lib/login.js && node --check lib/login-rpc.js && node --check lib/account-data.js && node --check lib/address-data.js && node --check lib/platform-service.js && node --check lib/client/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright-core": "1.61.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "mcp",
    "takeaway",
    "playwright"
  ],
  "author": "vb2250158",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-waimai.git"
  },
  "homepage": "https://github.com/vb2250158/dsh-waimai#readme",
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-waimai/issues"
  },
  "icon": "./icon.svg",
  "devDependencies": {
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
